  {
    "timestamp": "2026-07-27T03:59:36.043Z",
    "tool": "exec",
    "arguments": {
      "command": "cat << 'EOF' > regression_analysis.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import RandomForestRegressor\nfrom sklearn.preprocessing import LabelEncoder\n\n# Load the dataset\ndf = pd.read_csv('data/housing_dataset_chatgpt.csv')\n\n# Handle missing values (very simple approach for this task)\ndf = df.dropna()\n\n# Preprocessing\n# Categorical columns\ncat_cols = ['mainroad', 'guestroom', 'basement', 'hotwaterheating', 'airconditioning', 'prefarea', 'furnishingstatus']\n\n# Encode categorical columns\ndf_encoded = df.copy()\nfor col in cat_cols:\n    le = LabelEncoder()\n    df_encoded[col] = le.fit_transform(df[col].astype(str))\n\n# Features and Target\nX = df_encoded.drop('price', axis=1)\ny = df_encoded['price']\n\n# Feature Importance using Random Forest\nrf = RandomForestRegressor(n_estimators=100, random_state=42)\nrf.fit(X, y)\n\nimportances = rf.feature_importances_\nfeature_names = X.columns\nfeature_importance_df = pd.DataFrame({'Feature': feature_names, 'Importance': importances})\nfeature_importance_df = feature_importance_df.sort_values(by='Importance', ascending=False)\n\nprint(\"\\n--- Feature Importance (Random Forest) ---\")\nprint(feature_importance_df)\nEOF\npython3 regression_analysis.py"
    }
